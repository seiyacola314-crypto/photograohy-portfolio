:root {
  --bg: #0f0f10;
  --fg: #ececec;
  --muted: #8d8d92;
  --line: #26262a;
  --accent: #e8d9b5;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, "Helvetica Neue", "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
  line-height: 1.7;
}
a { color: inherit; }
code { background: #1c1c1f; padding: 2px 6px; border-radius: 4px; }

/* Header */
.site-header {
  position: sticky; top: 0; z-index: 10;
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 24px;
  background: rgba(15,15,16,.85);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line);
}
.brand { text-decoration: none; font-weight: 600; letter-spacing: .08em; }
.site-header nav a {
  margin-left: 20px; text-decoration: none; color: var(--muted);
  font-size: .92rem; transition: color .2s;
}
.site-header nav a:hover { color: var(--fg); }

/* Hero */
.hero { text-align: center; padding: 96px 24px 48px; }
.hero h1 { font-size: clamp(2rem, 6vw, 3.6rem); margin: 0 0 8px; font-weight: 300; letter-spacing: .12em; }
.hero p { color: var(--muted); margin: 0; letter-spacing: .2em; }

/* Filters */
.filters { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding: 0 16px 24px; }
.filters button {
  background: none; border: 1px solid var(--line); color: var(--muted);
  padding: 6px 16px; border-radius: 999px; cursor: pointer; font: inherit; font-size: .88rem;
  transition: all .2s;
}
.filters button:hover { color: var(--fg); border-color: var(--muted); }
.filters button.active { color: #111; background: var(--accent); border-color: var(--accent); }

/* Grid (masonry via columns) */
.grid { columns: 3 280px; column-gap: 14px; padding: 0 14px 48px; max-width: 1400px; margin: 0 auto; }
.item { break-inside: avoid; margin: 0 0 14px; position: relative; overflow: hidden; border-radius: 4px; cursor: zoom-in; background: #1a1a1c; }
.item img { width: 100%; display: block; transition: transform .5s ease, opacity .4s; }
.item:hover img { transform: scale(1.04); }
.item .tag {
  position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 14px 10px;
  background: linear-gradient(transparent, rgba(0,0,0,.75));
  font-size: .85rem; opacity: 0; transition: opacity .3s;
}
.item:hover .tag { opacity: 1; }
.empty { text-align: center; color: var(--muted); padding: 40px 16px 80px; }

/* Sections */
.narrow { max-width: 680px; margin: 0 auto; padding: 56px 24px; }
.narrow h2 { font-weight: 400; letter-spacing: .15em; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
.narrow p { color: #c5c5c9; }
.site-footer { text-align: center; padding: 32px 16px 48px; color: var(--muted); border-top: 1px solid var(--line); }

/* Lightbox */
.lightbox {
  position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,.95);
  display: flex; align-items: center; justify-content: center;
}
.lightbox[hidden] { display: none; }
.lightbox figure { margin: 0; max-width: 92vw; max-height: 92vh; text-align: center; }
.lightbox img { max-width: 92vw; max-height: 80vh; object-fit: contain; }
.lightbox figcaption { margin-top: 12px; color: #cfcfd3; font-size: .95rem; }
.lb-close, .lb-nav {
  position: absolute; background: none; border: none; color: #fff; cursor: pointer;
  font-size: 2.4rem; line-height: 1; padding: 12px 18px; opacity: .7;
}
.lb-close:hover, .lb-nav:hover { opacity: 1; }
.lb-close { top: 8px; right: 8px; }
.lb-nav { top: 50%; transform: translateY(-50%); }
.lb-nav.prev { left: 4px; }
.lb-nav.next { right: 4px; }

@media (max-width: 600px) {
  .site-header { padding: 12px 16px; }
  .site-header nav a { margin-left: 12px; }
  .hero { padding-top: 64px; }
  .grid { columns: 2 150px; column-gap: 8px; padding: 0 8px 32px; }
  .item { margin-bottom: 8px; }
}
